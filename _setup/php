    DeliverTo                  BIGINT UNSIGNED NOT NULL,
    RefVendorID                VARCHAR(30) DEFAULT NULL,
    Note                       TEXT DEFAULT NULL,
    Status                     ENUM('submitted','pending','approved','cancelled','closed') NOT NULL DEFAULT 'submitted'
);

-- SUPPLIER_QUOTATION_LINE v1
CREATE TABLE supplier_quotation_line (
    SupplierQuotationLineID    BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
    SupplierQuotationID        BIGINT UNSIGNED NOT NULL,
    SupplierRFQLineID          BIGINT UNSIGNED DEFAULT NULL,
    ItemID                     BIGINT UNSIGNED NOT NULL,
    ItemDesc                   TEXT NOT NULL,
    ItemSpec                   TEXT DEFAULT NULL,
    ItemNote                   TEXT DEFAULT NULL,
    UOM                        VARCHAR(50) NOT NULL DEFAULT 'unit',
