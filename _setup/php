-- SUPPLIER QUOTATION v1
CREATE TABLE supplier_quotation (
    SupplierQuotationID        BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
    RefSupplierQuotationID     VARCHAR(30) UNIQUE DEFAULT NULL,
    SupplierRFQID              BIGINT UNSIGNED NOT NULL,
    SupplierID                 BIGINT UNSIGNED NOT NULL,
    StaffID                    BIGINT UNSIGNED NOT NULL,
    ContactPerson              BIGINT UNSIGNED NOT NULL,
    Title                      VARCHAR(255) NOT NULL,
    BidValidityDays            DATETIME NOT NULL,
    QuotationDate              DATETIME NOT NULL,
    OrderDate                  DATETIME NOT NULL,
    OrderDeadline              DATETIME NOT NULL,
    ExpectedArrival            DATETIME NOT NULL,
    PaymentTerm                VARCHAR(30) NOT NULL DEFAULT '30D',
